generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid()) @db.Uuid
  name        String
  slug        String   @unique
  categorty   String
  images      String[]
  brand       String
  description String
  stock       Int
  price       Decimal  @default(0) @db.Decimal(12, 2)
  rating      Decimal  @default(0) @db.Decimal(3, 2)
  numReviews  Int      @default(0)
  isFeatured  Boolean  @default(false)
  banner      String?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
}

model User {
  id        String   @id @default(cuid()) @db.Uuid()
  name      String
  usenamer  String   @unique
  email     String   @unique
  password  String
  phone     Int      @unique
  createdAt DateTime @default(now()) @db.Timestamp(6)
}
